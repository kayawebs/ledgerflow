LEDGERFLOW_INDEXER_BIND_ADDR=0.0.0.0:8090
LEDGERFLOW_INDEXER_ENABLE_LEGACY_API=false
LEDGERFLOW_INDEXER_RPC_URL=http://127.0.0.1:18545
LEDGERFLOW_INDEXER_CHAIN_ID=8453
LEDGERFLOW_INDEXER_START_BLOCK=0
LEDGERFLOW_INDEXER_BATCH_SIZE=400
LEDGERFLOW_INDEXER_RPC_CONCURRENCY=8
LEDGERFLOW_INDEXER_RPC_REQUEST_DELAY_MS=10
LEDGERFLOW_INDEXER_RPC_RETRY_BASE_MS=1000
LEDGERFLOW_INDEXER_RPC_RETRY_MAX_MS=15000
LEDGERFLOW_INDEXER_RPC_MAX_RETRIES=10
LEDGERFLOW_INDEXER_LIVE_FOLLOW=true
LEDGERFLOW_INDEXER_POLL_INTERVAL_MS=2000
LEDGERFLOW_INDEXER_WORKER_ID=base_mainnet_top_level
LEDGERFLOW_INDEXER_QUERY_LIMIT_DEFAULT=1000
LEDGERFLOW_INDEXER_QUERY_LIMIT_MAX=10000
LEDGERFLOW_INDEXER_INTERNAL_API_TOKEN=

# Reuse the existing ClickHouse container from the parent LedgerFlow compose stack.
LEDGERFLOW_INDEXER_CLICKHOUSE_URL=http://127.0.0.1:8123
LEDGERFLOW_INDEXER_CLICKHOUSE_DATABASE=ledgerflow_indexer
LEDGERFLOW_INDEXER_CLICKHOUSE_USER=ledgerflow
LEDGERFLOW_INDEXER_CLICKHOUSE_PASSWORD=ledgerflow

# Admin/product database. This may point at the existing parent Postgres container.
LEDGERFLOW_INDEXER_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5532/ledgerflow

# Postmark email verification.
LEDGERFLOW_POSTMARK_SERVER_TOKEN=
LEDGERFLOW_EMAIL_FROM=verify@ledgerflow.local

# Billing verification.
LEDGERFLOW_BILLING_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
LEDGERFLOW_BILLING_MIN_CONFIRMATIONS=6

# Optional override for the built-in public demo token behavior.
# If unset, the service still enables:
# token=lf_test_ledgerflow_public_demo, rps=1, burst=3, max_limit=50
# LEDGERFLOW_INDEXER_TEST_API_TOKEN=
# LEDGERFLOW_INDEXER_TEST_API_RPS=1
# LEDGERFLOW_INDEXER_TEST_API_BURST=3
# LEDGERFLOW_INDEXER_TEST_API_MAX_LIMIT=50

LEDGERFLOW_ENV=local
LEDGERFLOW_BIND_ADDR=127.0.0.1:3000
LEDGERFLOW_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5532/ledgerflow
LEDGERFLOW_RPC_URL=http://127.0.0.1:8545
LEDGERFLOW_INDEXER_API_BASE_URL=http://127.0.0.1:8090
LEDGERFLOW_INDEXER_API_BEARER_TOKEN=
LEDGERFLOW_DEFAULT_CHAIN_ID=8453
LEDGERFLOW_TRACE_ENABLED=false
LEDGERFLOW_CLUSTER_BACKFILL_QUERY_LIMIT=10000
LEDGERFLOW_CLUSTER_AUTO_BACKFILL_ON_CREATE=true
LEDGERFLOW_CLUSTER_BACKFILL_WORKER_POLL_INTERVAL_MS=5000
LEDGERFLOW_ENABLED_RECOGNIZERS=selector_presence,erc20_transfer_flow,native_transfer,batch_router_heuristic,approval_swap_scenario
LEDGERFLOW_PLUGINS=sample_builtin_pack
LEDGERFLOW_WEB_BIND_ADDR=127.0.0.1:3001
LEDGERFLOW_WEB_BASE_URL=http://127.0.0.1:3001
LEDGERFLOW_API_BASE_URL=http://127.0.0.1:3000
LEDGERFLOW_SESSION_COOKIE_NAME=ledgerflow_session
LEDGERFLOW_EMAIL_FROM=
LEDGERFLOW_RESEND_API_KEY=
LEDGERFLOW_VERIFICATION_TTL_MINUTES=15
LEDGERFLOW_SESSION_TTL_DAYS=30

LEDGERFLOW_INDEXER_BIND_ADDR=0.0.0.0:8090
LEDGERFLOW_INDEXER_RPC_URL=http://host.docker.internal:18545
LEDGERFLOW_INDEXER_CLICKHOUSE_URL=http://clickhouse:8123
LEDGERFLOW_INDEXER_CLICKHOUSE_DATABASE=ledgerflow_indexer
LEDGERFLOW_INDEXER_CLICKHOUSE_USER=ledgerflow
LEDGERFLOW_INDEXER_CLICKHOUSE_PASSWORD=ledgerflow
LEDGERFLOW_INDEXER_CHAIN_ID=8453
LEDGERFLOW_INDEXER_START_BLOCK=0
LEDGERFLOW_INDEXER_BATCH_SIZE=200
LEDGERFLOW_INDEXER_RPC_CONCURRENCY=4
LEDGERFLOW_INDEXER_RPC_REQUEST_DELAY_MS=25
LEDGERFLOW_INDEXER_RPC_RETRY_BASE_MS=1000
LEDGERFLOW_INDEXER_RPC_RETRY_MAX_MS=15000
LEDGERFLOW_INDEXER_RPC_MAX_RETRIES=10
LEDGERFLOW_INDEXER_LIVE_FOLLOW=true
LEDGERFLOW_INDEXER_POLL_INTERVAL_MS=2000
LEDGERFLOW_INDEXER_WORKER_ID=base_mainnet_top_level
LEDGERFLOW_INDEXER_QUERY_LIMIT_DEFAULT=1000
LEDGERFLOW_INDEXER_QUERY_LIMIT_MAX=10000

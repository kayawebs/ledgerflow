LEDGERFLOW_ENV=local

# shared chain config
LEDGERFLOW_DEFAULT_CHAIN_ID=4663
LEDGERFLOW_RPC_URL=http://host.docker.internal:8545
LEDGERFLOW_TRACE_ENABLED=false

# RPC gateway used by Docker Compose to smooth bursts before the SSH/Base RPC tunnel.
# Host-local binaries can keep using LEDGERFLOW_RPC_URL directly.
LEDGERFLOW_RPC_GATEWAY_UPSTREAM_URL=http://host.docker.internal:18545
LEDGERFLOW_RPC_GATEWAY_HOST_PORT=18555
LEDGERFLOW_RPC_GATEWAY_MAX_IN_FLIGHT=8
LEDGERFLOW_RPC_GATEWAY_RPS=20
LEDGERFLOW_RPC_GATEWAY_BURST=20
LEDGERFLOW_RPC_GATEWAY_UPSTREAM_TIMEOUT_MS=30000
# Optional compose-only overrides. Leave unset to route containers through rpc-gateway.
# LEDGERFLOW_COMPOSE_RPC_URL=http://rpc-gateway:8545
# LEDGERFLOW_INDEXER_COMPOSE_RPC_URL=http://rpc-gateway:8545

# analysis api
# Docker Compose overrides the database host to db:5432; keep this host value for direct local runs.
LEDGERFLOW_BIND_ADDR=127.0.0.1:3000
LEDGERFLOW_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5532/ledgerflow
LEDGERFLOW_PLUGINS=sample_builtin_pack

# analysis -> indexer api
LEDGERFLOW_INDEXER_API_BASE_URL=http://127.0.0.1:8090
LEDGERFLOW_INDEXER_API_BEARER_TOKEN=your-long-random-secret

# cluster backfill worker (host run)
LEDGERFLOW_CLUSTER_BACKFILL_QUERY_LIMIT=10000
LEDGERFLOW_CLUSTER_AUTO_BACKFILL_ON_CREATE=true
LEDGERFLOW_CLUSTER_BACKFILL_WORKER_POLL_INTERVAL_MS=120000

# Searcher Cluster Intelligence. The RPC gateway remains the shared hard
# concurrency/rate boundary so this worker cannot create an unbounded burst.
LEDGERFLOW_SEARCHER_CLUSTER_POLL_INTERVAL_MS=1000
LEDGERFLOW_SEARCHER_CLUSTER_EXECUTION_BATCH_SIZE=4
LEDGERFLOW_SEARCHER_CLUSTER_BASIC_BATCH_SIZE=128
LEDGERFLOW_SEARCHER_CLUSTER_INITIAL_DEEP_SAMPLE=64
LEDGERFLOW_SEARCHER_CLUSTER_MAX_RELATIONSHIPS=20
LEDGERFLOW_SEARCHER_CLUSTER_MAX_MEMBERS=32
LEDGERFLOW_SEARCHER_CLUSTER_HISTORY_DAYS=30
LEDGERFLOW_SEARCHER_CLUSTER_STALE_CLAIM_SECONDS=180
LEDGERFLOW_SEARCHER_CLUSTER_INCREMENTAL_LAG_BLOCKS=2

# Protocol-scoped market clusters. These consume LedgerFlow's persisted Pons
# curve facts and verified arbitrage evidence; they do not query Searcher.
LEDGERFLOW_PROTOCOL_CLUSTER_CHAIN_ID=4663
LEDGERFLOW_PROTOCOL_CLUSTER_MIN_REPEATED_LAUNCHES=2
LEDGERFLOW_PROTOCOL_CLUSTER_MIN_VERIFIED_EXECUTIONS=2
LEDGERFLOW_PROTOCOL_CLUSTER_POLL_INTERVAL_MS=60000
LEDGERFLOW_PROTOCOL_CLUSTER_ERROR_INTERVAL_MS=15000

# trace net-delta monitor (host run)
LEDGERFLOW_TRACE_MONITOR_ENABLED=true
LEDGERFLOW_TRACE_MONITOR_WORKER_ID=base_mainnet_trace_monitor
# optional lower bound; live monitor skips old blocks when it falls behind
# LEDGERFLOW_TRACE_MONITOR_START_BLOCK=
LEDGERFLOW_TRACE_MONITOR_CONFIRMATIONS=3
LEDGERFLOW_TRACE_MONITOR_BLOCK_BATCH_SIZE=30
LEDGERFLOW_TRACE_MONITOR_POLL_INTERVAL_MS=10000
LEDGERFLOW_TRACE_MONITOR_RETENTION_DAYS=7
LEDGERFLOW_TRACE_MONITOR_BIND_ADDR=127.0.0.1:3010
LEDGERFLOW_TRACE_MONITOR_FAST_ARBITRAGE_ENABLED=true
LEDGERFLOW_TRACE_MONITOR_FAST_ARBITRAGE_SOURCE=rpc_logs
LEDGERFLOW_TRACE_MONITOR_FAST_ARBITRAGE_MIN_SWAPS=2
LEDGERFLOW_TRACE_MONITOR_FAST_ARBITRAGE_SOURCE_LAG_BLOCKS=20
LEDGERFLOW_TRACE_MONITOR_CRYPTOHOUSE_URL=https://crypto-clickhouse.clickhouse.com/?user=crypto
LEDGERFLOW_TRACE_MONITOR_LIGHT_DELTAS_ENABLED=true
LEDGERFLOW_TRACE_MONITOR_REPORT_ENABLED=true
LEDGERFLOW_TRACE_MONITOR_REPORT_INTERVAL_MS=3600000
LEDGERFLOW_TRACE_MONITOR_REPORT_WINDOW_MINUTES=60
LEDGERFLOW_TRACE_MONITOR_REPORT_TOP_N=10
LEDGERFLOW_TRACE_MONITOR_REPORT_MIN_RAW_SCORE=0
LEDGERFLOW_TRACE_MONITOR_NOTIFY_MIN_USD=10000
# required for public share links in monitor alerts
LEDGERFLOW_TRACE_DOMAIN=https://ledgerflow.top
LEDGERFLOW_ADDRESS_WHALE_THRESHOLD_USD=100000

# web product (host run)
LEDGERFLOW_WEB_BIND_ADDR=127.0.0.1:3001
LEDGERFLOW_WEB_BASE_URL=http://127.0.0.1:3001
LEDGERFLOW_API_BASE_URL=http://127.0.0.1:3000
LEDGERFLOW_WEB_DATABASE_MAX_CONNECTIONS=16
LEDGERFLOW_WEB_TODAY_CACHE_TTL_SECONDS=60
LEDGERFLOW_PUBLIC_EVIDENCE_FEED_URL=http://ledgerflow-base-pilot-web-1:3001/public/evidence/events.json
LEDGERFLOW_PUBLIC_EVIDENCE_CACHE_TTL_SECONDS=15
LEDGERFLOW_SESSION_COOKIE_NAME=ledgerflow_session
LEDGERFLOW_VERIFICATION_TTL_MINUTES=15
LEDGERFLOW_SESSION_TTL_DAYS=30

# login/register verification email delivery (not used for monitor alerts)
# auto: prefer Postmark if configured, otherwise Resend, otherwise log codes locally
LEDGERFLOW_EMAIL_DELIVERY_MODE=auto
LEDGERFLOW_EMAIL_FROM=
LEDGERFLOW_POSTMARK_SERVER_TOKEN=
LEDGERFLOW_POSTMARK_MESSAGE_STREAM=outbound
LEDGERFLOW_RESEND_API_KEY=

# Telegram-only confirmed monitor alerts
LEDGERFLOW_TELEGRAM_BOT_TOKEN=
LEDGERFLOW_TELEGRAM_CHAT_ID=

# Economic Monitoring Pilot v0.1 (Base data plane only; chain_id=8453)
LEDGERFLOW_PILOT_CONFIG=/app/config/pilots/example-base-project.yaml
LEDGERFLOW_PILOT_POLL_INTERVAL_MS=5000
LEDGERFLOW_PILOT_BATCH_SIZE=100
LEDGERFLOW_PILOT_ALERT_POLL_INTERVAL_MS=2000
LEDGERFLOW_PILOT_ALERT_BATCH_SIZE=50
LEDGERFLOW_PILOT_ALERT_GROUP_SIZE=5
LEDGERFLOW_PILOT_TELEGRAM_RATE_LIMIT_PER_MINUTE=20
LEDGERFLOW_PILOT_ALERT_MAX_ATTEMPTS=8
LEDGERFLOW_PILOT_REPORT_INTERVAL_MS=3600000
# Tests may override this with a local mock; production should keep Telegram's API.
LEDGERFLOW_TELEGRAM_API_BASE_URL=https://api.telegram.org

# top-level address indexer
LEDGERFLOW_INDEXER_BIND_ADDR=127.0.0.1:8090
LEDGERFLOW_INDEXER_RPC_URL=http://host.docker.internal:8545
LEDGERFLOW_INDEXER_CLICKHOUSE_URL=http://127.0.0.1:8123
LEDGERFLOW_INDEXER_CLICKHOUSE_DATABASE=ledgerflow_indexer
LEDGERFLOW_INDEXER_CLICKHOUSE_USER=ledgerflow
LEDGERFLOW_INDEXER_CLICKHOUSE_PASSWORD=ledgerflow
LEDGERFLOW_INDEXER_CHAIN_ID=4663
LEDGERFLOW_INDEXER_START_BLOCK=0
# LEDGERFLOW_INDEXER_END_BLOCK=
LEDGERFLOW_INDEXER_BATCH_SIZE=200
LEDGERFLOW_INDEXER_RPC_CONCURRENCY=4
LEDGERFLOW_INDEXER_RPC_BATCH_REQUEST_SIZE=1
LEDGERFLOW_INDEXER_RPC_REQUEST_DELAY_MS=25
LEDGERFLOW_INDEXER_RPC_REQUEST_TIMEOUT_MS=30000
LEDGERFLOW_INDEXER_RPC_RETRY_BASE_MS=1000
LEDGERFLOW_INDEXER_RPC_RETRY_MAX_MS=15000
LEDGERFLOW_INDEXER_RPC_MAX_RETRIES=10
LEDGERFLOW_INDEXER_WORKER_MODE=live
LEDGERFLOW_INDEXER_API_ENABLED=true
LEDGERFLOW_INDEXER_LAZY_ENABLED=true
LEDGERFLOW_INDEXER_LAZY_WORKER_ENABLED=false
LEDGERFLOW_INDEXER_LAZY_MAX_RANGE_BLOCKS=250000
LEDGERFLOW_INDEXER_LIVE_FOLLOW=true
LEDGERFLOW_INDEXER_LIVE_HEAD_LAG_BLOCKS=2
LEDGERFLOW_INDEXER_LIVE_BOOTSTRAP_BLOCKS=128

# Cold-start seed intelligence. Lower address-job numbers run first; production
# intentionally leaves generic sender/recipient jobs above 39 deferred.
LEDGERFLOW_ADDRESS_WORKER_CONCURRENCY=1
LEDGERFLOW_ADDRESS_WORKER_MAX_PRIORITY=14
LEDGERFLOW_ADDRESS_PRODUCER_MAX_ENQUEUE_PRIORITY=20
LEDGERFLOW_SEED_WORKER_ID=robinhood_seed_intelligence
LEDGERFLOW_SEED_WORKER_POLL_INTERVAL_MS=300000
LEDGERFLOW_SEED_MIN_MEV_CANDIDATE_TRANSACTIONS=3
LEDGERFLOW_SEED_MIN_MEV_DISTINCT_ROUTES=2
LEDGERFLOW_SEED_MAX_MEV_CANDIDATES=1000
LEDGERFLOW_SEED_MAX_ACTIVE_POOLS=500
LEDGERFLOW_SEED_MAX_QUEUED_PRIORITY=39
LEDGERFLOW_SEED_MAX_EVIDENCE_TRANSACTIONS_PER_SEED=8
LEDGERFLOW_SEED_MAX_RELATED_ADDRESSES=5000

# Bounded seed Economic Verifier. It consumes explicit transaction hashes and
# never requires full historical index coverage.
LEDGERFLOW_ECONOMIC_VERIFIER_WORKER_ID=robinhood_seed_economic_verifier
LEDGERFLOW_ECONOMIC_VERIFIER_POLL_INTERVAL_MS=5000
LEDGERFLOW_ECONOMIC_VERIFIER_BATCH_SIZE=2
LEDGERFLOW_ECONOMIC_VERIFIER_MAX_NEW_JOBS_PER_PASS=10
LEDGERFLOW_ECONOMIC_VERIFIER_MAX_PENDING_JOBS=50
LEDGERFLOW_ECONOMIC_VERIFIER_MAX_CANDIDATES_PER_SEED=2
LEDGERFLOW_ECONOMIC_VERIFIER_MAX_ATTEMPTS=3
LEDGERFLOW_ECONOMIC_VERIFIER_RETRY_DELAY_SECONDS=300
LEDGERFLOW_ECONOMIC_VERIFIER_STALE_CLAIM_SECONDS=120

# Observed Address Intelligence uses an optional address-history provider for
# complete discovery, then re-fetches and verifies every fact through canonical
# RPC. Without a provider it retains bounded local/RPC-log discovery.
LEDGERFLOW_OBSERVATION_WORKER_ID=observation_intelligence
LEDGERFLOW_OBSERVATION_WORKER_POLL_INTERVAL_MS=2000
LEDGERFLOW_OBSERVATION_MAX_TRANSACTIONS=10000
LEDGERFLOW_OBSERVATION_ANALYSIS_BATCH_SIZE=32
LEDGERFLOW_OBSERVATION_ANALYSIS_CONCURRENCY=8
LEDGERFLOW_OBSERVATION_HISTORY_DAYS=30
# Base example: https://base.blockscout.com . Leave empty on a chain without a
# compatible Blockscout account API. The provider is discovery-only.
LEDGERFLOW_OBSERVATION_HISTORY_API_BASE_URL=
LEDGERFLOW_OBSERVATION_HISTORY_API_PAGE_SIZE=1000
LEDGERFLOW_OBSERVATION_HISTORY_API_PAGES_PER_ITERATION=1
# Enable only when the selected provider can serve this endpoint reliably.
# Relevant internal flows are still reconstructed from canonical traces.
LEDGERFLOW_OBSERVATION_HISTORY_API_INCLUDE_INTERNAL_TRANSACTIONS=false
LEDGERFLOW_OBSERVATION_LOG_CHUNK_BLOCKS=50000
LEDGERFLOW_OBSERVATION_DISCOVERY_CHUNKS_PER_ITERATION=64
LEDGERFLOW_OBSERVATION_MAX_ATTEMPTS=3
LEDGERFLOW_OBSERVATION_STALE_CLAIM_SECONDS=120
LEDGERFLOW_OBSERVATION_INCREMENTAL_LAG_BLOCKS=2
LEDGERFLOW_OBSERVATION_ALERT_POLL_INTERVAL_MS=5000
LEDGERFLOW_OBSERVATION_ALERT_MAX_ATTEMPTS=8
LEDGERFLOW_OBSERVATION_ALERT_RATE_LIMIT_PER_MINUTE=20
LEDGERFLOW_INDEXER_HISTORY_HEAD_LAG_BLOCKS=128
LEDGERFLOW_INDEXER_REORG_LOOKBACK_BLOCKS=128
LEDGERFLOW_INDEXER_INTER_BATCH_DELAY_MS=0
LEDGERFLOW_INDEXER_POLL_INTERVAL_MS=200
LEDGERFLOW_INDEXER_WORKER_ID=robinhood_live
LEDGERFLOW_INDEXER_QUERY_LIMIT_DEFAULT=1000
LEDGERFLOW_INDEXER_QUERY_LIMIT_MAX=10000
LEDGERFLOW_INDEXER_INTERNAL_API_TOKEN=your-long-random-secret

# Optional diagnostic full-history worker. It is excluded from normal Compose
# startup by the `full-history` profile and is not a product prerequisite. Its
# fast pass stores canonical blocks and transaction bodies only;
# receipt/status/gas/log enrichment is intentionally deferred.
LEDGERFLOW_INDEXER_HISTORY_WORKER_ID=robinhood_history
LEDGERFLOW_INDEXER_HISTORY_START_BLOCK=0
LEDGERFLOW_INDEXER_HISTORY_BOUNDARY_WORKER_ID=robinhood_live
LEDGERFLOW_INDEXER_HISTORY_INCLUDE_RECEIPTS=false
LEDGERFLOW_INDEXER_HISTORY_RECEIPT_MODE=transaction
LEDGERFLOW_INDEXER_HISTORY_BATCH_SIZE=200
LEDGERFLOW_INDEXER_HISTORY_RPC_CONCURRENCY=16
LEDGERFLOW_INDEXER_HISTORY_RPC_BATCH_REQUEST_SIZE=4
LEDGERFLOW_INDEXER_HISTORY_RPC_REQUEST_DELAY_MS=0
LEDGERFLOW_INDEXER_HISTORY_RPC_REQUEST_TIMEOUT_MS=30000
LEDGERFLOW_INDEXER_HISTORY_INTER_BATCH_DELAY_MS=100
LEDGERFLOW_INDEXER_HISTORY_POLL_INTERVAL_MS=5000
# Must match the live worker's chain ID and checkpoint hashes.
# LEDGERFLOW_INDEXER_HISTORY_COMPOSE_RPC_URL=http://host.docker.internal:8547

# database-driven official registry synchronization
LEDGERFLOW_REGISTRY_SYNC_POLL_INTERVAL_MS=60000
LEDGERFLOW_REGISTRY_SYNC_RPC_CONCURRENCY=4
LEDGERFLOW_REGISTRY_SYNC_MAX_ENDPOINTS_PER_TICK=32
LEDGERFLOW_REGISTRY_SYNC_RUN_ONCE=false

# canonical factory/ERC-8056 event projection from ClickHouse into PostgreSQL
LEDGERFLOW_DISCOVERY_WORKER_ID=robinhood_contract_discovery
LEDGERFLOW_DISCOVERY_POLL_INTERVAL_MS=5000
LEDGERFLOW_DISCOVERY_ERROR_INTERVAL_MS=10000
LEDGERFLOW_DISCOVERY_BATCH_SIZE=500
LEDGERFLOW_DISCOVERY_LOOKBACK_BLOCKS=128
LEDGERFLOW_DISCOVERY_RPC_CONCURRENCY=1
LEDGERFLOW_DISCOVERY_RUN_ONCE=false

# canonical transaction/log address observations from ClickHouse into PostgreSQL
LEDGERFLOW_ADDRESS_PRODUCER_WORKER_ID=robinhood_address_facts
LEDGERFLOW_ADDRESS_PRODUCER_POLL_INTERVAL_MS=5000
LEDGERFLOW_ADDRESS_PRODUCER_ERROR_INTERVAL_MS=10000
LEDGERFLOW_ADDRESS_PRODUCER_BATCH_SIZE=250
LEDGERFLOW_ADDRESS_PRODUCER_REORG_LOOKBACK_BLOCKS=128
LEDGERFLOW_ADDRESS_PRODUCER_RUN_ONCE=false

# concurrent PostgreSQL address jobs consumed through the throttled RPC gateway
LEDGERFLOW_ADDRESS_WORKER_CONCURRENCY=4
LEDGERFLOW_BEHAVIOR_WORKER_ID=robinhood_behavior_assertions
LEDGERFLOW_BEHAVIOR_SOURCE_WORKER_ID=robinhood_address_facts
LEDGERFLOW_BEHAVIOR_RULE_VERSION=sender_frequency_v1
LEDGERFLOW_BEHAVIOR_WORKER_POLL_INTERVAL_MS=60000
LEDGERFLOW_BEHAVIOR_LOOKBACK_BLOCKS=50000
LEDGERFLOW_BEHAVIOR_MIN_TRANSACTION_COUNT=100
LEDGERFLOW_BEHAVIOR_MIN_ACTIVE_WINDOWS=8
LEDGERFLOW_BEHAVIOR_MIN_SPAN_BLOCKS=1000
LEDGERFLOW_BEHAVIOR_MIN_TX_PER_1000_BLOCKS=2.0
LEDGERFLOW_BEHAVIOR_MAX_CANDIDATES=1000
LEDGERFLOW_BEHAVIOR_ASSERTION_TTL_HOURS=24

# Separate protocol-market UI. It does not replace the existing web service.
LEDGERFLOW_MARKET_WEB_HOST_PORT=3001
# Public origin of the market site. Social cards, canonical links and the
# secure flag on session cookies are all derived from it, so a public
# deployment must set the real https origin here.
LEDGERFLOW_MARKET_WEB_BASE_URL=http://127.0.0.1:3001
LEDGERFLOW_MARKET_BASE_EVIDENCE_URL=http://ledgerflow-base-pilot-web-1:3001/public/evidence/events.json
LEDGERFLOW_MARKET_REMOTE_CACHE_TTL_SECONDS=30
LEDGERFLOW_MARKET_WALLET_CHALLENGE_TTL_SECONDS=300
LEDGERFLOW_MARKET_WALLET_SESSION_TTL_SECONDS=604800

# LedgerFlow-owned protocol launch/graduation projection. This uses targeted factory logs,
# not full-chain historical transaction indexing.
LEDGERFLOW_PROTOCOL_LAUNCH_CHAIN_ID=4663
LEDGERFLOW_PROTOCOL_LAUNCH_RPC_URL=http://127.0.0.1:18555
LEDGERFLOW_PROTOCOL_LAUNCH_COMPOSE_RPC_URL=http://rpc-gateway:8545
LEDGERFLOW_PROTOCOL_LAUNCH_BATCH_SIZE=5000
LEDGERFLOW_PROTOCOL_LAUNCH_HEAD_LAG_BLOCKS=2
LEDGERFLOW_PROTOCOL_LAUNCH_LOOKBACK_BLOCKS=128
LEDGERFLOW_PROTOCOL_LAUNCH_HEADER_BATCH_SIZE=100
LEDGERFLOW_PROTOCOL_LAUNCH_METADATA_FETCH_LIMIT=8
LEDGERFLOW_PROTOCOL_LAUNCH_METADATA_FETCH_TIMEOUT_MS=5000
LEDGERFLOW_PROTOCOL_LAUNCH_ACTIVE_DELAY_MS=250
LEDGERFLOW_PROTOCOL_LAUNCH_POLL_INTERVAL_MS=2000
LEDGERFLOW_PROTOCOL_LAUNCH_ERROR_INTERVAL_MS=10000
# Optional recovery/validation floor. Leave unset for full history from each database seed.
# LEDGERFLOW_PROTOCOL_LAUNCH_START_BLOCK_OVERRIDE=57800000

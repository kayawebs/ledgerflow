# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=release /ledgerflow /usr/local/bin/ledgerflow
COPY --from=release /web /usr/local/bin/web
COPY --from=release /ledgerflow_indexer /usr/local/bin/ledgerflow_indexer
COPY --from=release /ledgerflow_cryptohouse_indexer_backfill /usr/local/bin/ledgerflow_cryptohouse_indexer_backfill
COPY --from=release /ledgerflow_backfill_worker /usr/local/bin/ledgerflow_backfill_worker
COPY --from=release /ledgerflow_price_worker /usr/local/bin/ledgerflow_price_worker
COPY --from=release /ledgerflow_address_worker /usr/local/bin/ledgerflow_address_worker
COPY --from=release /ledgerflow_trace_monitor /usr/local/bin/ledgerflow_trace_monitor
COPY --from=release /ledgerflow_rpc_gateway /usr/local/bin/ledgerflow_rpc_gateway

ENV RUST_LOG=info

CMD ["ledgerflow"]

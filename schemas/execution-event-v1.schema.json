{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerflow.local/schemas/execution-event-v1.schema.json",
  "title": "LedgerFlow Execution Event v1",
  "description": "Public contract for an evidence-backed economic execution event. Unknown values remain null or absent and must not be coerced to zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "chain_id",
    "event_type",
    "status",
    "severity",
    "conclusion",
    "participants",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "ledgerflow.execution-event.v1" },
    "id": { "type": "string", "minLength": 1 },
    "chain_id": { "type": "integer", "minimum": 1 },
    "tx_hash": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "event_type": {
      "enum": [
        "dex_arbitrage",
        "backrun",
        "liquidation",
        "liquidation_attempt",
        "repeated_failed_attempts",
        "large_asset_flow",
        "protocol_revenue",
        "treasury_movement",
        "solver_execution",
        "unknown_material_interaction"
      ]
    },
    "status": {
      "enum": ["detected", "verified", "investigating", "resolved", "dismissed"]
    },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "conclusion": { "type": "string", "minLength": 1 },
    "economic_impact": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "null"] },
        "asset": { "type": ["string", "null"] },
        "usd_value": { "type": ["number", "null"] },
        "gas_cost": { "type": ["string", "null"] },
        "net_profit": { "type": ["string", "null"] }
      }
    },
    "confidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "level": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "role"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "role": { "type": "string" },
          "label": { "type": ["string", "null"] }
        }
      }
    },
    "evidence_summary": { "type": ["object", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "occurred_at": { "type": ["string", "null"], "format": "date-time" }
  }
}

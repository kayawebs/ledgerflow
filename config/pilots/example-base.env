# Public, non-secret example for a Base-only Pilot data plane.
# Supply a production Base RPC URL through the shell/secret manager; do not commit it here.
LEDGERFLOW_DEFAULT_CHAIN_ID=8453
LEDGERFLOW_IMAGE=ledgerflow:phase1-base
# Compose service `env_file` must use this plane's file rather than the
# Robinhood-oriented repository .env.
LEDGERFLOW_ENV_FILE=config/pilots/example-base.env
LEDGERFLOW_INDEXER_CHAIN_ID=8453
LEDGERFLOW_TRACE_ENABLED=true
LEDGERFLOW_RPC_GATEWAY_UPSTREAM_URL=https://mainnet.base.org
LEDGERFLOW_COMPOSE_RPC_URL=http://rpc-gateway:8545
LEDGERFLOW_INDEXER_LIVE_COMPOSE_RPC_URL=http://rpc-gateway:8545
LEDGERFLOW_INDEXER_LIVE_WORKER_ID=base_pilot_live
LEDGERFLOW_INDEXER_LAZY_WORKER_ID=base_pilot_lazy
LEDGERFLOW_INDEXER_HISTORY_WORKER_ID=base_pilot_history
LEDGERFLOW_INDEXER_HISTORY_BOUNDARY_WORKER_ID=base_pilot_live
LEDGERFLOW_INDEXER_LIVE_INCLUDE_RECEIPTS=true
LEDGERFLOW_INDEXER_LAZY_INCLUDE_RECEIPTS=true
LEDGERFLOW_PILOT_CONFIG=/app/config/pilots/example-base-project.yaml

# Resource-safe address intelligence for actively observed objects. The
# producer records canonical facts slowly but does not enqueue the cold-start
# population; priority 0-10 is reserved for explicit Observe/API requests.
LEDGERFLOW_ADDRESS_PRODUCER_WORKER_ID=base_address_facts
LEDGERFLOW_ADDRESS_PRODUCER_BATCH_SIZE=25
LEDGERFLOW_ADDRESS_PRODUCER_INTER_BATCH_DELAY_MS=2000
LEDGERFLOW_ADDRESS_PRODUCER_MAX_ENQUEUE_PRIORITY=0
LEDGERFLOW_ADDRESS_WORKER_CONCURRENCY=1
LEDGERFLOW_ADDRESS_WORKER_MAX_PRIORITY=10
LEDGERFLOW_ADDRESS_HISTORY_LOOKBACK_BLOCKS=50000
LEDGERFLOW_ADDRESS_HISTORY_ANALYSIS_LIMIT=32

# Lazy work is bounded. It may fill a recent activity gap, but cannot turn an
# address lookup into a genesis-to-head Base replay.
LEDGERFLOW_INDEXER_LAZY_MAX_RANGE_BLOCKS=50000
LEDGERFLOW_INDEXER_LAZY_BATCH_SIZE=5
LEDGERFLOW_INDEXER_LAZY_RPC_CONCURRENCY=1
LEDGERFLOW_INDEXER_LAZY_REQUEST_DELAY_MS=200

# Collision-free example ports for running beside the existing Robinhood stack.
POSTGRES_HOST_PORT=5546
CLICKHOUSE_HTTP_HOST_PORT=8224
CLICKHOUSE_NATIVE_HOST_PORT=9103
LEDGERFLOW_RPC_GATEWAY_HOST_PORT=19556
LEDGERFLOW_API_HOST_PORT=3200
LEDGERFLOW_WEB_HOST_PORT=3201
LEDGERFLOW_INDEXER_HOST_PORT=8191
LEDGERFLOW_TRACE_MONITOR_HOST_PORT=3111

# Telegram tokens and customer chat IDs belong in runtime secrets, not this file.
LEDGERFLOW_WEB_BASE_URL=http://127.0.0.1:3201
